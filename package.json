{
  "name": "super-tudo",
  "private": true,
  "version": "3.74.89",
  "description": "Protected build tooling for the proprietary Super Tudo application",
  "scripts": {
    "build:protected": "node scripts/build-protected.mjs",
    "check:ui": "node scripts/check-ui-standards.mjs",
    "build:deploy": "npm run check:ui && npm run check:navigation && npm run check:notification-sounds && npm run check:notification-reliability && npm run check:sync && npm run check:routine && npm run check:service-worker && npm run check:pickers && npm run check:recipes && npm run check:notes && npm run check:imports && npm run build:protected",
    "deploy": "npm run build:deploy && wrangler deploy",
    "check:sync": "node scripts/check-sync-contract.mjs",
    "check:routine": "node scripts/check-routine.mjs",
    "check:service-worker": "node scripts/check-service-worker.mjs",
    "check:pickers": "node scripts/check-pickers.mjs",
    "check:recipes": "node scripts/check-recipes.mjs",
    "check:notes": "node scripts/check-notes.mjs",
    "check:notification-sounds": "node scripts/check-notification-sounds.mjs",
    "check:notification-reliability": "node scripts/check-notification-reliability.mjs",
    "check:navigation": "node scripts/check-navigation-contract.mjs",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "devDependencies": {
    "javascript-obfuscator": "5.10.1",
    "terser": "5.51.4",
    "wrangler": "4.165.0",
    "acorn": "8.15.0"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
